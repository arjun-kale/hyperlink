# Template for the release signing config (Phase 11).
#
# Copy this file to `keystore.properties` (already in .gitignore — never
# commit the real one or the keystore file itself) and fill in real values
# to produce a properly signed release build:
#
#   cp keystore.properties.example keystore.properties
#   keytool -genkey -v -keystore release.keystore -alias hyperlink \
#       -keyalg RSA -keysize 2048 -validity 10000
#
# Without this file present, `./gradlew assembleRelease` still succeeds (so
# CI and local `-PbuildType=release` smoke builds keep working) but falls
# back to debug signing and prints a warning — that output is NOT suitable
# for distribution to real users, only for local testing of the release
# build's shrinking/minification behavior.

storeFile=/absolute/path/to/release.keystore
storePassword=changeme
keyAlias=hyperlink
keyPassword=changeme
